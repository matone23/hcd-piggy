{
  "rules": {
    "users": {
      ".read": true,
      ".write": true,
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "tempImages": {
      ".read": true,
      ".write": true,
      "$imageId": {
        ".read": true,
        ".write": true
      }
    },
    "rooms": {
      ".read": true,
      ".write": true,
      ".indexOn": ["isActive", "createdAt"],
      "$roomId": {
        ".read": true,
        ".write": true,
        "participants": {
          ".read": true,
          ".write": true,
          "$participantId": {
            ".read": true,
            ".write": true
          }
        },
        "submissions": {
          ".read": true,
          ".write": true,
          "$submissionId": {
            ".read": true,
            ".write": true
          }
        }
      }
    }
  }
}